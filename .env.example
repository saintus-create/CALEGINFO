# Default starter mode. Use a strong value (16+ characters recommended).
EVE_CHAT_PASSWORD=

# Optional production mode. Configure every value in this section to switch
# from browser storage/password auth to Neon, Upstash, and Sign in with Vercel.
DATABASE_URL=
BETTER_AUTH_SECRET=
NEXT_PUBLIC_VERCEL_APP_CLIENT_ID=
VERCEL_APP_CLIENT_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: long-term memory in a private Vercel Blob store (any mode).
# Set by `pnpm exec eve integration setup file-memory`. Memory stays disabled on
# Vercel until one of these is present; generic BLOB_* variables are ignored.
EVE_MEMORY_BLOB_STORE_ID=
EVE_MEMORY_BLOB_WEBHOOK_PUBLIC_KEY=

# Optional: override the app origin for a custom production domain.
BETTER_AUTH_URL=

# Optional: enable hosted Vercel Connect integrations.
SLACK_CONNECTOR=
LINEAR_CONNECTOR=
NOTION_CONNECTOR=
SENTRY_CONNECTOR=

# --- Research service key (set this in production) ---
# The server route that answers questions authenticates to Sarvam with this.
# When unset, the app falls back to the built-in key shipped in lib/engine.js.
# Set your own key here for production and rotate the built-in one.
SARVAM_API_KEY=
# Optional: point the server at a different Sarvam-compatible base URL.
SARVAM_BASE_URL=

# --- Voice: dictation in the composer, read aloud on answers ---
# Both run on the same Sarvam subscription key as chat (SARVAM_API_KEY above,
# or the built-in key in lib/engine.js when that is unset). If the key has no
# speech entitlement, or the endpoints are unreachable, the browser falls back
# to its own Web Speech APIs, so the controls keep working either way.
#
# Speech to text. saaras:v3 supports modes; saarika:v2.5 is the legacy model.
# SARVAM_STT_MODEL=saaras:v3
# SARVAM_STT_MODE=transcribe         # transcribe | translate | verbatim | translit | codemix ("off" disables STT)
# SARVAM_STT_LANGUAGE=unknown        # "unknown" auto-detects; e.g. en-IN, hi-IN
#
# Read aloud (bulbul). Speaker, language and pace are the API's own knobs.
# SARVAM_TTS_MODEL=bulbul:v2
# SARVAM_TTS_SPEAKER=anushka         # alias: SARVAM_TTS_VOICE
# SARVAM_TTS_LANGUAGE=en-IN
# SARVAM_TTS_PACE=1                  # 0.5 – 2.0
#
# Disable one half of the pipeline (the browser fallback still serves it).
# SARVAM_STT_ENABLED=1
# SARVAM_TTS_ENABLED=1
#
# Point the voice endpoints elsewhere: a regional host, a proxy, or the local
# mock (scripts/mock_sarvam.mjs) used by `pnpm run check:voice`.
# Defaults to SARVAM_BASE_URL with any trailing /v1 removed, else api.sarvam.ai.
# SARVAM_VOICE_BASE_URL=
# SARVAM_STT_URL=
# SARVAM_TTS_URL=
# SARVAM_VOICE_TIMEOUT_MS=45000

# --- Unfiltered model toggle (one variable) ---
# Set an OpenRouter key and the Standard/Unfiltered toggle appears in the app
# header. "Unfiltered" runs Dolphin Mistral 24B Venice Edition (uncensored,
# 128k context) through OpenRouter. Create a key at https://openrouter.ai
# OPENROUTER_API_KEY=

# --- Alternate chat models (optional, overrides the built-in) ---
# Add any OpenAI-compatible model (OpenRouter, Together, Groq, a local
# vLLM/Ollama server, ...). JSON array; each entry:
#   id        unique id shown in the model picker
#   name      display name
#   apiBase   OpenAI-compatible base URL
#   model     the model string sent to that endpoint
#   apiKeyEnv name of the env var holding that provider's API key
# An entry is only listed/served when its apiKeyEnv variable is set.
# Example:
# ALTERNATE_MODELS_JSON=[{"id":"llama-3.3-70b","name":"Llama 3.3 70B","apiBase":"https://openrouter.ai/api/v1","model":"meta-llama/llama-3.3-70b-instruct","apiKeyEnv":"OPENROUTER_API_KEY"}]
# OPENROUTER_API_KEY=

# --- Live legislative data via Firecrawl (optional) ---
# Enables bill_text_search (keyword search over full bill text) and bill_detail
# (one measure's live text, status, history, roll-call votes) from
# leginfo.legislature.ca.gov. Get a key at https://firecrawl.dev
# FIRECRAWL_API_KEY=

# --- Retrieval pipeline hooks (optional) ---
# The search pipeline runs deterministically without any of these. Configure
# them to add the semantic and LLM stages described in the product's public
# retrieval architecture; each activates only when its variables are present.
#
# Dense (embedding) fusion: blends cosine similarity into the hybrid score.
# Any OpenAI-compatible embeddings endpoint works.
# EMBEDDING_API_BASE=https://api.openai.com/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small
#
# LLM reranking of the top candidates (uses SARVAM_API_KEY / OPENAI_API_KEY /
# OPENROUTER_API_KEY for the call). Off unless set to 1.
# RETRIEVAL_LLM_RERANK=0
